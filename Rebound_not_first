            Repair = false
        },
        Earthquake = {
            Enabled = false
        },
        CameraShake = {
            Enabled = true
        },
        Crucifixion = {
            Type = "Guiding", -- "Guiding"
            Enabled = true,
            Range = 40,
            Resist = true,
            Break = true
        },
