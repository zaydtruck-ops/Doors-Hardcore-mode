            HeightOffset = 2
        },
        Movement = {
            Speed = 60,
            Delay = 5,
            Reversed = true
        },
        Damage = {
            Enabled = true,
            IgnoreHiding = false,
            Range = 40,
            Amount = 200
        },
        Rebounding = {
            Enabled = false,
            Type = "Ambush", -- "Blitz"
            Min = 1,
            Max = 1,
            Delay = 5
        },
        Lights = {
