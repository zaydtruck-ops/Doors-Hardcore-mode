local entity = spawner.Create({
	Entity = {
		Name = "Cease",
		Asset = "rbxassetid://136831598848553",
		HeightOffset = 0
	},
	Lights = {
		Flicker = {
			Enabled = false,
			Duration = 7
		},
		Shatter = false,
		Repair = false
	},
	Earthquake = {
		Enabled = false
	},
	CameraShake = {
		Enabled = true
	},
	Movement = {
		Speed = 40,
		Delay = 0,
		Reversed = false
	},
	Rebounding = {
		Enabled = false
	},
	Damage = {
		Enabled = false
	},
	Crucifixion = {
		Enabled = true,
		Range = 40,
		Resist = false,
		Break = true
	},
	Death = {
		Type = "Guiding",
		Hints = {
			"You died to who you call Cease.",
      "It signals it's arrival by turning the lights to a blue-ish hue and playing a sound cue.",
      "When it is here, do not move, as it's hearing is extremely advanced.",
      "Good luck !"
		},
		Cause = "Cease"
	}
})

entity:SetCallback("OnSpawned", function()
	print("Cease has spawned")

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")

	repeat
		task.wait()
	until entity.Model

	local ceaseModel = entity.Model
	ceaseModel.Silence.Playing = false

	task.spawn(function()
		repeat 
		task.wait(0.1)
		until ceaseModel.RoomsEntered:GetAttribute(tostring(number - 2))
		
	end)

	local hitboxRange = 60
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {ceaseModel}

	local raycastLoop

	raycastLoop = RunService.Heartbeat:Connect(function()
		local origin = ceaseModel:GetPivot().Position

		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character

			if character
				and character:FindFirstChild("HumanoidRootPart")
				and character:FindFirstChild("Humanoid") then

				local hrp = character.HumanoidRootPart
				local humanoid = character.Humanoid

				local direction = (hrp.Position - origin).Unit
				local rayResult = workspace:Raycast(
					origin,
					direction * hitboxRange,
					params
				)

				if rayResult
					and rayResult.Instance
					and rayResult.Instance:IsDescendantOf(character) then

					local isMovingByInput =
						humanoid.MoveDirection.Magnitude > 0.1

					local isMovingByVelocity =
						hrp.AssemblyLinearVelocity.Magnitude > 2

					if isMovingByInput
						and isMovingByVelocity
						and humanoid.Health > 0 then

						humanoid.Health = 0

						local sound = Instance.new("Sound")
						sound.SoundId = "rbxassetid://4988621968"
						sound.Volume = 10
						sound.PlaybackSpeed = 0.7
						sound.Parent = workspace
						sound:Play()

						print(
							player.Name
								.. " was killed by Cease for moving!"
						)

						local statsFolder =
							game.ReplicatedStorage:FindFirstChild("GameStats")

						if statsFolder then
							local playerStats =
								statsFolder:FindFirstChild(
									"Player_" .. player.Name
								)

							if playerStats
								and playerStats:FindFirstChild("Total")
								and playerStats.Total:FindFirstChild("DeathCause") then

								playerStats.Total.DeathCause.Value = "Cease"
							end
						end
					end
				end
			end
		end
	end)

	entity:SetCallback("OnStartMoving", function()
		print("Entity has started moving")
		task.wait(4)
		local ceaseModel = entity.Model
		ChangeLights(Color3.fromRGB(0, 45, 185), Color3.fromRGB(120, 130, 255), 2, 20)
		ceaseModel.Silence:Play()
	end)

	entity:SetCallback("OnDespawning", function()
		print("Cease has disappeared")

		if raycastLoop then
			raycastLoop:Disconnect()
		end

		local achievementGiver = loadstring(
			game:HttpGet(
				"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"
			)
		)()

		achievementGiver({
			Title = "Not a sound near it.",
			Desc = "Worse than the Figure...",
			Reason = "Survive Cease.",
			Image = "rbxassetid://104367200417966"
		})
	end)
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
	if newHealth == 0 then
		print("Cease has killed the player")
	else
		print("Cease has damaged the player")
	end
end)

entity:Run()
